pipeline {
    agent any

    stages {
        stage('Clone Repo') {
            steps {
                git branch: 'main', url: 'https://github.com/MahiTzy/linux-devops-learning.git'
            }
        }

        stage('Deploy to App Server') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@13.201.190.123 "
                cd linux-devops-learning/Jenkins_Pipeline_Assignment/node-flask-app/frontend &&
                git reset --hard &&
                git clean -fd &&
                git pull &&
                npm install &&
                pm2 restart frontend || pm2 start app.js --name frontend
                "
                '''
            }
        }
    }
}