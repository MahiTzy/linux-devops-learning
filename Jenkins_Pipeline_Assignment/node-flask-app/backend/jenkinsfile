pipeline {
    agent any

    stages {
        stage('Clone Repo') {
            steps {
                git branch: 'main', url: 'https://github.com/MahiTzy/linux-devops-learning.git'
            }
        }

        stage('Deploy to App Server') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@13.201.190.123 "

                cd linux-devops-learning/Jenkins_Pipeline_Assignment/node-flask-app/backend &&
                git reset --hard &&
                git clean -fd &&
                git pull &&

                # Create venv if not exists
                if [ ! -d "venv" ]; then
                    python3 -m venv venv
                fi &&

                source venv/bin/activate &&
                pip install -r requirements.txt &&
                pm2 restart backend || pm2 start app.py --name backend --interpreter ./venv/bin/python
                "
                '''
            }
        }
    }
}